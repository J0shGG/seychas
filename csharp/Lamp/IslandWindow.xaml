<Window x:Class="Lamp.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лампа"
        Width="360" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False">
    <Grid>
        <Border x:Name="Capsule"
                Width="292" Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="24"
                Background="{DynamicResource IslandFillBrush}"
                BorderBrush="{DynamicResource IslandLineBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                Cursor="Hand"
                MouseEnter="Capsule_MouseEnter"
                MouseLeave="Capsule_MouseLeave"
                MouseLeftButtonDown="Capsule_MouseLeftButtonDown"
                MouseLeftButtonUp="Capsule_MouseLeftButtonUp"
                MouseMove="Capsule_MouseMove">
            <Grid Margin="14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="TopRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,10,0" Fill="{DynamicResource CopperBrush}"/>
                    <TextBlock x:Name="TimeText" FontFamily="{StaticResource Serif}" FontSize="18"
                               Foreground="{DynamicResource PaperBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="LabelText" FontFamily="{StaticResource Sans}" FontSize="13"
                               Foreground="{DynamicResource PaperBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                    <TextBlock x:Name="StatusText" FontFamily="{StaticResource Sans}" FontSize="11"
                               Foreground="{DynamicResource CopperBrightBrush}" VerticalAlignment="Center"
                               Margin="10,0,0,0" Opacity="0.85"/>
                </StackPanel>
                <StackPanel x:Name="Body" Grid.Row="1" Margin="18,0,18,12" Opacity="0">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource Serif}" FontSize="20"
                               Foreground="{DynamicResource PaperBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="PaceText" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TodayText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="IntentText" FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource GoldBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                    <Button x:Name="DoneButton" Content="Задача выполнена" Style="{StaticResource Ghost}"
                            HorizontalAlignment="Left" FontSize="12" Padding="12,6"
                            Click="DoneButton_Click"/>
                    <Border x:Name="ProgressTrack" Height="3" CornerRadius="2" Background="#33E8C9A0" Margin="0,10,0,0">
                        <Border x:Name="ProgressFill" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                                Width="0" Background="{DynamicResource CopperBrightBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
