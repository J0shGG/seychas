<Window x:Class="Lamp.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лампа"
        Width="460" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{StaticResource Sans}"
        Foreground="{DynamicResource GoldBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,12,0">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/icon.jpg" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Лампа 2.0" FontFamily="{StaticResource Serif}" FontSize="28" Foreground="{DynamicResource PaperBrush}"/>
                <TextBlock Text="переход с Electron" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,-2,0,0"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{DynamicResource PaperBrush}"
                   Text="Ставим новую Лампу на это место. Задачи, мысли и журнал дней переносятся с компьютера автоматически."/>
        <TextBlock x:Name="StatusLabel" Grid.Row="2" VerticalAlignment="Center" FontSize="13"
                   Foreground="{DynamicResource CopperBrightBrush}" Text="Готовим переход…"/>
        <ProgressBar x:Name="Bar" Grid.Row="3" Height="8" Margin="0,8,0,16" IsIndeterminate="True"
                     Foreground="{DynamicResource CopperBrush}" Background="#22FFFFFF" BorderThickness="0"/>
        <Button x:Name="CloseBtn" Grid.Row="4" Content="Закрыть" Style="{StaticResource Ghost}"
                HorizontalAlignment="Right" Visibility="Collapsed" Click="CloseBtn_Click"/>
    </Grid>
</Window>
