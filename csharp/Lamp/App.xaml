<Application x:Class="Lamp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Color x:Key="Paper">#f3ead8</Color>
        <Color x:Key="Muted">#b7a894</Color>
        <Color x:Key="Copper">#c4784a</Color>
        <Color x:Key="CopperBright">#e8a06a</Color>
        <Color x:Key="Gold">#e8c9a0</Color>
        <Color x:Key="Ink">#1c1612</Color>
        <Color x:Key="Panel">#94100B08</Color>
        <Color x:Key="WindowBg">#120e0b</Color>
        <Color x:Key="IslandFill">#14110f</Color>
        <Color x:Key="IslandOpen">#1b1512</Color>
        <Color x:Key="IslandLine">#38E8C9A0</Color>
        <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
        <SolidColorBrush x:Key="CopperBrush" Color="{StaticResource Copper}"/>
        <SolidColorBrush x:Key="CopperBrightBrush" Color="{StaticResource CopperBright}"/>
        <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/>
        <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBg}"/>
        <SolidColorBrush x:Key="IslandFillBrush" Color="{StaticResource IslandFill}"/>
        <SolidColorBrush x:Key="IslandOpenBrush" Color="{StaticResource IslandOpen}"/>
        <SolidColorBrush x:Key="IslandLineBrush" Color="{StaticResource IslandLine}"/>
        <SolidColorBrush x:Key="DeskBackground" Color="#120e0b"/>
        <FontFamily x:Key="Serif">Georgia, Palatino Linotype, Times New Roman, serif</FontFamily>
        <FontFamily x:Key="Sans">Segoe UI, Segoe UI Variable, sans-serif</FontFamily>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
            <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CopperBrightBrush}"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#24E8C9A0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <ControlTemplate x:Key="RectButton" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="BorderBrush" Value="#38E8C9A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource RectButton}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2AFFFFFF"/>
                    <Setter Property="BorderBrush" Value="#66E8C9A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipOn" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource CopperBrush}"/>
            <Setter Property="Foreground" Value="#1c1410"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CopperBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CopperBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CopperBrightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="BorderBrush" Value="#48E8C9A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource RectButton}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CopperBrightBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CopperBrush}"/>
            <Setter Property="Foreground" Value="#1c1410"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CopperBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template" Value="{StaticResource RectButton}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CopperBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CopperBrightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="#24E8C9A0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="BorderBrush" Value="#30E8C9A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template" Value="{StaticResource RectButton}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2AFFFFFF"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CopperBrightBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
