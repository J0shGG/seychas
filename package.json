{
  "name": "seychas",
  "private": true,
  "version": "1.4.0",
  "description": "Лампа — фокус на одной задаче",
  "author": "Сейчас",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "icons": "node scripts/make-icon.mjs",
    "dist": "npm run icons && npm run build && electron-builder --win",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "koffi": "^3.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.90.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "app.seychas.desktop",
    "productName": "Seychas",
    "copyright": "Лампа",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/koffi-win32-x64/**/*"
    ],
    "asarUnpack": [
      "node_modules/@koromix/koffi-win32-x64/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Seychas.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Лампа",
      "uninstallDisplayName": "Лампа",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Seychas-Setup.exe"
    }
  }
}
